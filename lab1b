# ============================================================
# CAR PREDICTION DATASET
# KDD FRAMEWORK IMPLEMENTATION
# ============================================================

# -----------------------------
# Step 1: Import Libraries
# -----------------------------

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeRegressor
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error

# -----------------------------
# Step 2: Selection
# -----------------------------

df = pd.read_csv("car_prediction_data.csv")

print("="*50)
print("FIRST FIVE RECORDS")
print("="*50)
print(df.head())

print("\nDataset Shape")
print(df.shape)

print("\nColumn Names")
print(df.columns)

# -----------------------------
# Step 3: Preprocessing
# -----------------------------

print("\nMissing Values")
print(df.isnull().sum())

# Remove duplicate records
df.drop_duplicates(inplace=True)

# Fill Missing Values (if any)
for col in df.columns:
    if df[col].dtype in ['float64', 'int64']:
        df[col] = df[col].fillna(df[col].median())

print("\nMissing Values After Cleaning")
print(df.isnull().sum())

print("\nDataset Information")
print(df.info())

print("\nStatistical Summary")
print(df.describe())

# -----------------------------
# Step 4: Transformation
# -----------------------------

# Feature Engineering: Calculate Car Age from Manufacturing Year
df['Car_Age'] = 2026 - df['Year']

# Drop columns not suitable for modeling
df_model = df.drop(columns=['Year', 'Car_Name'])

# One-Hot Encoding for Categorical Features
df_model = pd.get_dummies(df_model, drop_first=True)

# Separate Features and Target
X = df_model.drop("Selling_Price", axis=1)
y = df_model["Selling_Price"]

print("\nFeatures")
print(X.head())

print("\nTarget")
print(y.head())

# -----------------------------
# Step 5: Data Mining
# -----------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

model = DecisionTreeRegressor(random_state=42)

model.fit(X_train, y_train)

prediction = model.predict(X_test)

# -----------------------------
# Step 6: Evaluation
# -----------------------------

r2 = r2_score(y_test, prediction)
mae = mean_absolute_error(y_test, prediction)
mse = mean_squared_error(y_test, prediction)

print(f"\nR2 Score                = {r2:.4f}")
print(f"Mean Absolute Error     = {mae:.4f}")
print(f"Mean Squared Error      = {mse:.4f}")

# -----------------------------
# Step 7: Knowledge Presentation
# -----------------------------

# Selling Price Distribution
plt.figure(figsize=(7,5))
plt.hist(df["Selling_Price"], bins=15)
plt.title("Selling Price Distribution")
plt.xlabel("Selling Price (Lakhs)")
plt.ylabel("Count")
plt.show()

# Fuel Type Distribution
plt.figure(figsize=(6,4))
sns.countplot(x="Fuel_Type", data=df)
plt.title("Fuel Type Distribution")
plt.show()

# Seller Type Distribution
plt.figure(figsize=(6,4))
sns.countplot(x="Seller_Type", data=df)
plt.title("Seller Type Distribution")
plt.show()

# Transmission Type Distribution
plt.figure(figsize=(6,4))
sns.countplot(x="Transmission", data=df)
plt.title("Transmission Distribution")
plt.show()

# Kilometers Driven Distribution
plt.figure(figsize=(7,5))
plt.hist(df["Kms_Driven"], bins=15)
plt.title("Kilometers Driven Distribution")
plt.show()

# Present Price Distribution
plt.figure(figsize=(7,5))
plt.hist(df["Present_Price"], bins=15)
plt.title("Present Price Distribution")
plt.show()

# Correlation Heatmap
plt.figure(figsize=(10,6))
sns.heatmap(df_model.corr(),
            annot=True,
            cmap="coolwarm",
            linewidths=0.5)

plt.title("Correlation Heatmap")
plt.show()

# -----------------------------
# Feature Importance
# -----------------------------

importance = pd.DataFrame({
    "Feature": X.columns,
    "Importance": model.feature_importances_
}).sort_values(
    by="Importance",
    ascending=False
)

print("\nFeature Importance")
print(importance)

plt.figure(figsize=(10,6))
sns.barplot(
    data=importance,
    x="Importance",
    y="Feature"
)

plt.title("Feature Importance")
plt.show()

# -----------------------------
# Final Output
# -----------------------------

print("="*50)
print("KDD FRAMEWORK COMPLETED SUCCESSFULLY")
print("="*50)

print("Dataset Shape :", df.shape)

print("Training Records :", len(X_train))

print("Testing Records :", len(X_test))

print("Decision Tree R2 Score :", round(r2 * 100, 2), "%")

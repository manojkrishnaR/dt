import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns

# Set visual style for academic presentation
sns.set_theme(style="whitegrid")
plt.rcParams["font.sans-serif"] = "DejaVu Sans"

# Load the dataset
df = pd.read_csv("car_prediction_data.csv")

print(df.head())

plt.figure(figsize=(10, 5))

# Violin Plot: Present Price across Fuel Types
sns.violinplot(
    data=df,
    x="Fuel_Type",
    y="Present_Price",
    palette="Pastel1",
    inner="quartile",
    hue="Fuel_Type",
)

plt.title("Present Price Distribution by Fuel Type", fontsize=14, fontweight="bold")
plt.xlabel("Fuel Type", fontsize=12)
plt.ylabel("Present Price (Lakhs)", fontsize=12)
plt.tight_layout()
plt.show()
